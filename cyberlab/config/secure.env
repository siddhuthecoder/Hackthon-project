# SentinelForge Lab - Secure configuration template (VULN-014 remediation target)
#
# config/demo.env is the intentionally vulnerable counterpart: it hard-codes fake
# secrets in a committed file so a secret scanner has something to find.
# This file is the pattern you are supposed to end up with - a committed template
# with placeholders only, and every real value supplied through the environment.
#
# Copy to .env (git-ignored) or export the variables before `docker compose up`.
# NEVER commit a filled-in copy of this file.

# --- required -----------------------------------------------------------------

# MongoDB connection string. In the lab: mongodb://mongodb:27017/sentinelforge
MONGODB_URI=<set-me-via-environment>

# Redis connection string for the security-events pub/sub stream.
REDIS_URL=<set-me-via-environment>

# Signing key for access tokens (15 min). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-48-byte-random-value>

# Signing key for refresh tokens (7 days). Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=<generate-a-different-48-byte-random-value>

# --- optional -----------------------------------------------------------------

# Base URL of the internal service used by the SSRF demonstration.
INTERNAL_SERVICE_URL=http://internal-service:8080

# Root directory of the path-traversal sandbox.
DEMO_FILES_DIR=/app/demo-files

# API listen port.
API_PORT=3001

NODE_ENV=development