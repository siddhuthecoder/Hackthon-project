# Copy to .env (gitignored) and fill in. No real secrets go in this file.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/sfplatform
SF_CORS_ORIGIN=http://localhost:3000

# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SF_JWT_SECRET=

# Required before `npm run seed`. Pick your own local demo passwords.
SF_ADMIN_EMAIL=admin@sentinelforge.ai
SF_ADMIN_PASSWORD=
SF_ANALYST_EMAIL=analyst@sentinelforge.ai
SF_ANALYST_PASSWORD=

# CyberLab adapter (must match cyberlab/.env LAB_CONTROL_KEY)
CYBERLAB_URL=http://localhost:3001
LAB_CONTROL_KEY=
CYBERLAB_JWT_SECRET=
CYBERLAB_POLL_MS=1500
SF_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,api,host.docker.internal

# AI (optional). Both empty = offline mode (real, data-derived, just not model-generated).
# Provider precedence: OpenRouter first, then Anthropic, then offline.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SF_AI_MAX_TOOL_ROUNDS=8

SF_DETECTION_INTERVAL_MS=2000

# Optional: generic incoming-webhook URL (Slack/Discord/any relay accepting {"text": "..."}).
# Posts a formatted alert the moment an incident is created. Empty = disabled.
WEBHOOK_URL=

# Optional: only needed for modules/remediation/githubPr.ts ("Open Fix PR" button), and only
# works when the backend runs in host dev mode (needs git/gh + the actual repo checkout).
SF_REPO_ROOT=
